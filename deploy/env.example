# dagu-gate deployment configuration - single source of truth for one machine.
#
# Migration flow on a new server:
#   1. cp deploy/env.example env
#   2. edit env (paths, gateway URL, admin credentials, offline image archives)
#   3. bash scripts/install.sh --env env
#
# Every setting below is optional: install.sh falls back to built-in defaults
# when a variable is missing. Keep the KEY=VALUE shape; no quotes needed unless
# the value contains spaces.

# Deployment root: dagu binary, dags, scripts, templates, users, data, archive.
DAGU_ROOT=/home/li/dagu-run

# Public gateway URL used by user workspaces (browser entry point).
GATEWAY_PUBLIC_BASE_URL=http://192.168.252.131:9088

# dagu management API address as seen from the host.
DAGU_API=http://172.17.0.1:18080

# Offline image archives; only used when the image is not already loaded.
OPENCODE_IMAGE_TAR=/home/li/dagu/opencode-1.17.10-custom-nods-python-pandas.tar.gz
CADDY_IMAGE_TAR=/home/li/dagu/caddy.2.11.4.tar

# Admin account initialized on first install.
DAGU_ADMIN_USER=admin
DAGU_ADMIN_PASS=dagu-gate-2026

# Docker network shared by the gateway and user containers.
DOCKER_NETWORK=dagu-net

# OpenCode container settings (defaults; usually leave as-is).
OPENCODE_PORT=4096
OPENCODE_EXECUTABLE=opencode
READINESS_TIMEOUT=60

# --- Idle reclamation (stop idle user containers + wake on access) ---
# Stop user containers idle longer than this many minutes (360 = 6 hours).
IDLE_TIMEOUT_MINUTES=360
# reap_idle cron expression (dagu standard 5-field cron); default every minute.
# 必须加引号：env 文件会被 bash source，不带引号会触发通配符展开导致报错。
REAP_CRON="* * * * *"
# Graceful stop timeout (seconds) passed to `docker stop -t`.
STOP_TIMEOUT=30
# Starting-page auto refresh interval (seconds).
START_PAGE_REFRESH=5
# workerd (control-plane logic service) listening port.
WORKERD_PORT=9090
# UID/GID for the Caddy container (must be able to read/write the logs dir).
GATEWAY_UID=1000
GATEWAY_GID=1000
