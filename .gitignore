# Build artifacts: keep the folder in the repo (see dist/README.md),
# but never commit the ~190MB dagu binary (exceeds GitHub file size limit).
/dist/*
!/dist/README.md

# Secrets & machine-specific runtime state (never commit)
/.webhook-tokens/
/gateway/.env
/.deploy-env
/env
/server.log
/server.pid

# Runtime data (created on the target host by scripts/install.sh)
/logs/
/users/
/data/
/archive/
/templates/
# dags/: rendered DAG yamls are machine-specific and generated by
# scripts/install.sh from deploy/dags/*.tpl — keep only the placeholder.
/dags/*
!/dags/.gitkeep

# OS / editor / Python
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.idea/
.vscode/
